    <string name="settings_diagnostics">Diagnostic</string>
    <string name="settings_diagnostics_footnote">Conservé sur cet appareil jusqu\u2019à ce que vous le copiiez, et jamais envoyé nulle part. Ne contient aucun texte de livre, aucun titre, aucun nom de fichier et aucune clé.</string>
    <string name="settings_developer">Options pour développeurs</string>
    <string name="settings_developer_info">Place le diagnostic et le dernier rapport de plantage au bas de cette page. Les deux restent sur cet appareil et ne sont jamais envoyés nulle part. Désactivez pour les masquer à nouveau.</string>
    <string name="settings_record_problems">Consigner ce qui ne va pas</string>
