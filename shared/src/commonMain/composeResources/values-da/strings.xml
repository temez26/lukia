    <string name="settings_accent">Accentfarve</string>
    <string name="settings_accent_footnote">Bruges til læseforløbet, valgte rækker og alt, der gør noget. Tema følger paletten.</string>
    <string name="settings_motion">Bevægelse</string>
    <string name="settings_motion_footnote">Hvordan appen bevæger sig, når den åbnes, og når skærme skifter. Knapper og betjeningselementer svarer ens, uanset hvad du vælger.</string>
    <string name="settings_the_page">Siden</string>
    <string name="settings_the_page_footnote">Hvordan hver bog åbnes. Læserens eget panel ændrer de samme indstillinger med en bog foran dig.</string>
    <string name="settings_text_and_images">Tekst og billeder</string>
    <string name="settings_text_and_images_footnote">Disse gælder bøger med flydende tekst. En PDF, der læses som sine egne sider, fik sin skrift sat, da filen blev lavet, og intet af dette når den.</string>
    <string name="settings_opening_a_pdf">At åbne en PDF</string>
    <string name="settings_opening_a_pdf_as_text">Nye PDF-filer ombrydes af denne app – dens skrift i den størrelse, du bad om, og oversættelser inde i afsnittet i stedet for oven på siden. En scanning uden tekst åbnes alligevel som sine egne sider.</string>
    <string name="settings_opening_a_pdf_as_pages">Nye PDF-filer åbnes, som filens skaber satte dem op. Enhver af dem kan alligevel læses som tekst fra læserens eget panel.</string>
    <string name="settings_translate_into_footnote">Tryk på en sætning, mens du læser, for at oversætte den, og tryk igen for originalen.</string>
    <string name="settings_pointing_at_the_book">At pege på bogen</string>
    <string name="settings_pointing_footnote">Hver af dem gør én ting, altid. At gøre det igen samme sted lægger bogens egne ord tilbage – undtagen på et ord, du har slået op, hvor et hold i stedet åbner mere om det.</string>
    <string name="settings_tap_to_translate">Tryk på et ord for at oversætte det</string>
    <string name="settings_asking_for_more">At bede om mere end et ord</string>
    <string name="settings_asking_for_more_footnote">En ordbog svarer på et ord og intet større, så disse gør ingenting, før en oversættelsestjeneste er sat op ovenfor. Fra her er det samme fra som kontakterne under Oversættelse.</string>
    <string name="settings_hold_again">Hold et ord igen for mere om det</string>
    <string name="settings_translating_ahead">At oversætte i forvejen</string>
    <string name="settings_translating_ahead_footnote">Begge er nye, og begge er langsomme og dyre: de oversætter en skærmfuld ad gangen i stedet for det sted, du pegede på. Slået fra, indtil du beder om dem, og helt skjult for læseren så længe.</string>
    <string name="settings_on_screen_detail">Tilføjer en knap, der oversætter hver sætning, du kan se, én gang.</string>
    <string name="settings_as_you_read_detail">Tilføjer en knap, der bliver ved med at oversætte alt, der ruller ind, indtil du slår den fra. Det er den dyre.</string>
    <string name="settings_ai_translation">AI-oversættelse</string>
    <string name="settings_use_ai">Brug en oversættelsestjeneste</string>
    <string name="settings_use_ai_detail">Slået fra slår Lukia ét ord op i en gratis ordbog og gør intet andet – ingen nøgle at indtaste, ingen knapper i læseren. Slået til kan den oversætte hele sætninger og afsnit via en tjeneste, du sætter op og betaler for pr. afsnit. At slå fra bevarer alt, du har sat op.</string>
    <string name="settings_translation_service">Oversættelsestjeneste</string>
    <string name="settings_translation_service_footnote">Intet på denne side gør noget, før denne er sat op. At slå et ord op under Oversættelse virker uden den; en hel sætning gør ikke — den går til en model, du betaler for pr. afsnit.</string>
