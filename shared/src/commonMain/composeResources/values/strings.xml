<?xml version="1.0" encoding="utf-8"?>
<!--
    Every word the app says, in the language it was written in.

    One file rather than one per feature: the resource generator is scoped to the
    Gradle module and `shared` is one module, so a file per feature is not
    something it can be told to produce. Ownership is carried by the key prefix
    instead - `nav_`, `menu_`, `state_`, `action_`, and a prefix per feature as
    each one moves across - which also makes a feature that has fallen behind a
    translation visible in a diff.

    Keys say what the string is for, not what it says. `action_close` survives
    somebody deciding the button should read "Done"; `action_close_this_panel`
    would not.

    A translation is a sibling directory - `values-fi/strings.xml` - and nothing
    else. Nothing here is looked up by its English text.
-->
<resources>

    <!-- The bottom tab bar. -->
    <string name="nav_home">Home</string>
    <string name="nav_search">Search</string>
    <string name="nav_library">Library</string>

    <!-- Controls that appear on more than one screen. -->
    <string name="action_cancel">Cancel</string>
    <string name="action_close">Close</string>
    <string name="action_delete">Delete</string>
    <string name="action_done">Done</string>
    <string name="action_close_panel">Close this panel</string>
    <string name="state_loading">Loading</string>

    <!-- The actions one book offers, wherever it is shown. -->
    <string name="menu_book_details">Book Details</string>
    <string name="menu_favourite">Add to Favourites</string>
    <string name="menu_unfavourite">Remove from Favourites</string>
    <string name="menu_select_books">Select Books</string>
    <string name="menu_refresh_details">Refresh Details</string>
    <string name="menu_delete_from_library">Delete from Library</string>

    <!--
        The library's own notices. Every one is a whole sentence: the counts are
        arguments, never something glued on at the call site, and the verb of a
        bulk report belongs to its own string rather than being swapped into a
        shared frame.
    -->
    <string name="library_details_refreshed">Details refreshed</string>

    <plurals name="library_already_in_library">
        <item quantity="one">Already in your library</item>
        <item quantity="other">All %1$d already in your library</item>
    </plurals>

    <string name="library_imported_with_existing">Imported %1$d, %2$d already added</string>
    <string name="library_imported_with_failures">Imported %1$d, %2$d skipped</string>
    <string name="library_imported_mixed">Imported %1$d, %2$d already added, %3$d skipped</string>

    <plurals name="library_bulk_refreshed">
        <item quantity="one">1 book refreshed</item>
        <item quantity="other">%1$d books refreshed</item>
    </plurals>
    <plurals name="library_bulk_updated">
        <item quantity="one">1 book updated</item>
        <item quantity="other">%1$d books updated</item>
    </plurals>
    <plurals name="library_bulk_reset">
        <item quantity="one">1 book set back to unread</item>
        <item quantity="other">%1$d books set back to unread</item>
    </plurals>
    <plurals name="library_bulk_deleted">
        <item quantity="one">1 book removed from your library</item>
        <item quantity="other">%1$d books removed from your library</item>
    </plurals>

    <!-- Wraps a bulk report where some books could not be reached. -->
    <plurals name="library_bulk_skipped">
        <item quantity="one">%1$s, 1 skipped</item>
        <item quantity="other">%1$s, %2$d skipped</item>
    </plurals>

    <!-- The bar over the shelf while books are being picked, and while one runs. -->
    <string name="library_select_books">Select books</string>
    <string name="library_select_all">Select All</string>
    <string name="library_deselect_all">Deselect All</string>
    <string name="library_selected_count">%1$d selected</string>
    <string name="library_bulk_running_refresh">Refreshing %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_favourite">Favouriting %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_unfavourite">Unfavouriting %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_reset">Resetting %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_delete">Deleting %1$d of %2$d\u2026</string>

    <string name="library_delete_confirm_message">The files stay where they are on disk.</string>
    <plurals name="library_delete_confirm_title">
        <item quantity="one">Delete 1 book from your library?</item>
        <item quantity="other">Delete %1$d books from your library?</item>
    </plurals>

</resources>
