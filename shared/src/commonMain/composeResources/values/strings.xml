<?xml version="1.0" encoding="utf-8"?>
<!--
    Every word the app says, in the language it was written in.

    One file rather than one per feature: the resource generator is scoped to the
    Gradle module and `shared` is one module, so a file per feature is not
    something it can be told to produce. Ownership is carried by the key prefix
    instead - `nav_`, `menu_`, `state_`, `action_`, and a prefix per feature as
    each one moves across - which also makes a feature that has fallen behind a
    translation visible in a diff.

    Keys say what the string is for, not what it says. `action_close` survives
    somebody deciding the button should read "Done"; `action_close_this_panel`
    would not.

    A translation is a sibling directory - `values-fi/strings.xml` - and nothing
    else. Nothing here is looked up by its English text.
-->
<resources>

    <!-- The bottom tab bar. -->
    <string name="nav_home">Home</string>
    <string name="nav_search">Search</string>
    <string name="nav_library">Library</string>

    <!-- Controls that appear on more than one screen. -->
    <string name="action_cancel">Cancel</string>
    <string name="action_close">Close</string>
    <string name="action_delete">Delete</string>
    <string name="action_done">Done</string>
    <string name="action_close_panel">Close this panel</string>
    <string name="state_loading">Loading</string>

    <!-- The actions one book offers, wherever it is shown. -->
    <string name="menu_book_details">Book Details</string>
    <string name="menu_favourite">Add to Favourites</string>
    <string name="menu_unfavourite">Remove from Favourites</string>
    <string name="menu_select_books">Select Books</string>
    <string name="menu_refresh_details">Refresh Details</string>
    <string name="menu_delete_from_library">Delete from Library</string>

    <!--
        The library's own notices. Every one is a whole sentence: the counts are
        arguments, never something glued on at the call site, and the verb of a
        bulk report belongs to its own string rather than being swapped into a
        shared frame.
    -->
    <string name="library_details_refreshed">Details refreshed</string>

    <plurals name="library_already_in_library">
        <item quantity="one">Already in your library</item>
        <item quantity="other">All %1$d already in your library</item>
    </plurals>

    <string name="library_imported_with_existing">Imported %1$d, %2$d already added</string>
    <string name="library_imported_with_failures">Imported %1$d, %2$d skipped</string>
    <string name="library_imported_mixed">Imported %1$d, %2$d already added, %3$d skipped</string>

    <plurals name="library_bulk_refreshed">
        <item quantity="one">1 book refreshed</item>
        <item quantity="other">%1$d books refreshed</item>
    </plurals>
    <plurals name="library_bulk_updated">
        <item quantity="one">1 book updated</item>
        <item quantity="other">%1$d books updated</item>
    </plurals>
    <plurals name="library_bulk_reset">
        <item quantity="one">1 book set back to unread</item>
        <item quantity="other">%1$d books set back to unread</item>
    </plurals>
    <plurals name="library_bulk_deleted">
        <item quantity="one">1 book removed from your library</item>
        <item quantity="other">%1$d books removed from your library</item>
    </plurals>

    <!-- Wraps a bulk report where some books could not be reached. -->
    <plurals name="library_bulk_skipped">
        <item quantity="one">%1$s, 1 skipped</item>
        <item quantity="other">%1$s, %2$d skipped</item>
    </plurals>

    <!-- The bar over the shelf while books are being picked, and while one runs. -->
    <string name="library_select_books">Select books</string>
    <string name="library_select_all">Select All</string>
    <string name="library_deselect_all">Deselect All</string>
    <string name="library_selected_count">%1$d selected</string>
    <string name="library_bulk_running_refresh">Refreshing %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_favourite">Favouriting %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_unfavourite">Unfavouriting %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_reset">Resetting %1$d of %2$d\u2026</string>
    <string name="library_bulk_running_delete">Deleting %1$d of %2$d\u2026</string>

    <string name="library_delete_confirm_message">The files stay where they are on disk.</string>
    <plurals name="library_delete_confirm_title">
        <item quantity="one">Delete 1 book from your library?</item>
        <item quantity="other">Delete %1$d books from your library?</item>
    </plurals>

    <!--
        What each failure is called and what it says. Paired: a title alone is
        too vague to act on, and the pair is too long for a snackbar - see
        `AppErrorDisplay.kt`, which chooses between them.
    -->
    <string name="error_document_not_found_title">Document not found</string>
    <string name="error_document_not_found_message">It may have been moved or removed from your library.</string>
    <string name="error_unsupported_file_title">Unsupported file</string>
    <string name="error_unsupported_file_message">Lukia can open PDF and EPUB files.</string>
    <string name="error_format_not_readable_title">Not readable yet</string>
    <string name="error_format_not_readable_message">Reading EPUB files is not ready yet - PDFs open today.</string>
    <string name="error_empty_folder_title">Nothing to import</string>
    <string name="error_empty_folder_message">No books found in this folder or the folders inside it.</string>
    <string name="error_translation_unavailable_title">Translation is not set up</string>
    <string name="error_translation_unavailable_message">Choose a language to translate into in Settings, and add a translation service.</string>
    <string name="error_translation_failed_title">Could not translate that</string>
    <string name="error_translation_failed_message">The translation service did not answer. Try again.</string>
    <string name="error_unexpected_title">Something went wrong</string>
    <string name="error_unexpected_message">An unexpected error occurred.</string>

    <!--
        The app's own choices, named. These used to be fields on the enums
        themselves - and two of them were the enum constant's name, rendered
        straight to the screen - which is why there was nothing here to translate
        and why renaming a constant changed the UI.
    -->
    <string name="theme_system">System</string>
    <string name="theme_light">Light</string>
    <string name="theme_dark">Dark</string>

    <string name="palette_crisp">Crisp</string>
    <string name="palette_crisp_detail">White cards on grey, true black at night.</string>
    <string name="palette_paper">Paper</string>
    <string name="palette_paper_detail">Warm paper and ink, easy on the eyes for long sittings.</string>
    <string name="palette_slate">Slate</string>
    <string name="palette_slate_detail">Cool neutral greys and flat, quiet chrome.</string>

    <string name="accent_themed">Theme</string>
    <string name="accent_blue">Blue</string>
    <string name="accent_violet">Violet</string>
    <string name="accent_green">Green</string>
    <string name="accent_amber">Amber</string>
    <string name="accent_rose">Rose</string>
    <string name="accent_graphite">Graphite</string>

    <string name="motion_calm">Calm</string>
    <string name="motion_calm_detail">Quick cross-fades. Nothing springs, slides or sparkles.</string>
    <string name="motion_standard">Standard</string>
    <string name="motion_standard_detail">A short opening, and screens that move the way you sent them.</string>
    <string name="motion_playful">Playful</string>
    <string name="motion_playful_detail">A longer opening, springier settling, and further to travel.</string>

    <!-- How a PDF is put on the screen. -->
    <string name="pdf_layout_original">Original</string>
    <string name="pdf_layout_text">Text</string>

    <!-- The reading surface, as the settings panel and the settings screen name it. -->
    <string name="reader_theme_light">Light</string>
    <string name="reader_theme_sepia">Sepia</string>
    <string name="reader_theme_dark">Dark</string>
    <string name="reader_typeface_serif">Serif</string>
    <string name="reader_typeface_sans">Sans</string>
    <string name="reader_alignment_ragged">Ragged</string>
    <string name="reader_alignment_justified">Justified</string>
    <string name="reader_spacing_tight">Tight</string>
    <string name="reader_spacing_normal">Normal</string>
    <string name="reader_spacing_relaxed">Relaxed</string>
    <string name="reader_figure_small">Small</string>
    <string name="reader_figure_normal">Normal</string>
    <string name="reader_figure_large">Large</string>
    <string name="reader_figure_fill">Fill</string>
    <!-- A page width, as the share of the window it takes. -->
    <!--
        A bare "%" rather than an escaped "%%": Compose Resources does not
        read "%%" as an escape and would print both signs. Verified against
        `ReaderChromeTest.theLargerPageWidthsAreOffered`.
    -->
    <string name="reader_width_percent">%1$d%</string>

    <!-- How the shelf is laid out. -->
    <string name="library_layout_grid">Grid</string>
    <string name="library_layout_list">List</string>

    <!--
        Translation choices. Four of these name a company or a website rather
        than a thing - Anthropic, OpenAI, Google, Wiktionary, Sanakirja - and are
        here so the picker reads from one place, not because they want
        translating. Leave them as they are.
    -->
    <string name="gesture_off">Off</string>
    <string name="passage_unit_word">Word</string>
    <string name="passage_unit_sentence">Sentence</string>
    <string name="passage_unit_paragraph">Paragraph</string>

    <string name="provider_anthropic">Anthropic</string>
    <string name="provider_openai">OpenAI</string>
    <string name="provider_local">Local</string>

    <string name="word_lookup_translator">Translator</string>
    <string name="word_lookup_translator_footnote">Words go to the same service as sentences, with the paragraph around them - so the answer is the sense the book meant.</string>
    <string name="word_lookup_google">Google</string>
    <string name="word_lookup_google_footnote">Fast and free, and it never sees the book - only the word. Add a Cloud Translation key below to use Google's supported API rather than the public endpoint.</string>
    <string name="word_lookup_dictionary">Dictionary</string>
    <string name="word_lookup_dictionary_footnote">Wiktionary's own entry for the word: every sense it has, rather than the one sense something guessed at. Free, and nothing to set up.</string>

    <!-- The button that leaves the app for the reader's chosen site. -->
    <string name="reader_open_in_site">Open in %1$s</string>
    <string name="word_site_google">Google</string>
    <string name="word_site_google_footnote">Google Translate, with the word already in the box - so the alternatives and the reverse lookup are one tap away.</string>
    <string name="word_site_wiktionary">Wiktionary</string>
    <string name="word_site_wiktionary_footnote">The whole entry as Wiktionary lays it out: every language that spells the word this way, its inflections and its examples.</string>
    <string name="word_site_sanakirja">Sanakirja</string>
    <string name="word_site_sanakirja_footnote">sanakirja.org, which is worth the trip for the Nordic languages in particular. Opens on the pair you are reading.</string>
    <string name="word_site_custom">Custom</string>
    <string name="word_site_custom_footnote">Any site with a searchable address. Write {word} where the word goes, and {to} or {from} for the languages if the site takes them.</string>

</resources>
