    <string name="settings_accent_footnote">Se usa para el avance de lectura, las filas elegidas y todo lo que actúa. Tema sigue a la paleta.</string>
    <string name="settings_motion">Movimiento</string>
    <string name="settings_motion_footnote">Cómo se mueve la aplicación al abrirse y al cambiar de pantalla. Los botones y los controles responden igual, elijas lo que elijas.</string>
    <string name="settings_the_page">La página</string>
    <string name="settings_the_page_footnote">Cómo se abre cada libro. El panel del lector cambia los mismos ajustes con un libro delante.</string>
    <string name="settings_text_and_images">Texto e imágenes</string>
    <string name="settings_text_and_images_footnote">Estos valen para los libros de texto fluido. Un PDF leído como sus propias páginas recibió su composición al crearse el archivo, y nada de esto le llega.</string>
    <string name="settings_opening_a_pdf">Abrir un PDF</string>
    <string name="settings_opening_a_pdf_as_text">Los PDF nuevos los recompone esta aplicación – su tipografía en el tamaño que has pedido, y las traducciones dentro del párrafo en lugar de sobre la página. Un escaneo sin texto se abre igualmente como sus propias páginas.</string>
    <string name="settings_opening_a_pdf_as_pages">Los PDF nuevos se abren tal como los compuso quien hizo el archivo. Cualquiera de ellos se puede leer igualmente como texto desde el panel del lector.</string>
    <string name="settings_translate_into_footnote">Toca una frase mientras lees para traducirla, y tócala otra vez para ver el original.</string>
    <string name="settings_pointing_at_the_book">Señalar el libro</string>
    <string name="settings_pointing_footnote">Cada uno hace una sola cosa, siempre. Repetirlo en el mismo pasaje devuelve las palabras del libro – salvo en una palabra que hayas buscado, donde mantener abre más sobre ella.</string>
    <string name="settings_tap_to_translate">Toca una palabra para traducirla</string>
    <string name="settings_asking_for_more">Pedir más que una palabra</string>
    <string name="settings_asking_for_more_footnote">Un diccionario responde a una palabra y a nada mayor, así que esto no hace nada hasta configurar arriba un servicio de traducción. Apagado aquí es el mismo apagado que los interruptores de Traducción.</string>
    <string name="settings_hold_again">Mantener una palabra otra vez para saber más</string>
    <string name="settings_translating_ahead">Traducir por adelantado</string>
    <string name="settings_translating_ahead_footnote">Ambas son nuevas, y ambas son lentas y caras: traducen una pantalla entera de una vez en lugar del pasaje que has señalado. Desactivadas hasta que las pidas, y mientras tanto ocultas del todo al lector.</string>
    <string name="settings_on_screen_detail">Añade un botón que traduce una vez cada frase que ves.</string>
    <string name="settings_as_you_read_detail">Añade un botón que sigue traduciendo todo lo que entra en pantalla hasta que lo apagues. Este es el caro.</string>
    <string name="settings_ai_translation">Traducción con IA</string>
    <string name="settings_use_ai">Usar un servicio de traducción</string>
    <string name="settings_use_ai_detail">Apagado, Lukia busca una sola palabra en un diccionario gratuito y no hace nada más: ninguna clave que introducir, ningún control en el lector. Encendido, puede traducir frases y párrafos enteros mediante un servicio que configuras y pagas por pasaje. Apagarlo conserva todo lo que has configurado.</string>
    <string name="settings_translation_service">Servicio de traducción</string>
    <string name="settings_translation_service_footnote">Nada de esta página hace nada hasta que esto esté configurado. Buscar una palabra en Traducción funciona sin ello; una frase entera no: va a un modelo que pagas por pasaje.</string>
