-- Where a book was left off.
--
-- A table of its own rather than columns on `document`, because it has its own
-- lifetime: most books in a library have never been opened, and the ones that
-- have are written to as they are read while the rest are not touched at all.
--
-- `pageCount` is stored beside the page so that how far through a book someone
-- is can be answered without opening it.
--
-- Not a foreign key on `document`, which would tie this to a table it has no
-- reason to be locked to - a position can be stored for a book the library was
-- never told about. Removing a book clears its position all the same; that is
-- `RemoveDocumentUseCase`'s doing rather than the schema's.
--
-- `readAt` orders the shelf by what was read last. It counts writes rather than
-- telling the time - one past the highest in the table - for the same reason
-- `translation_cache.usedAt` does: a device clock can be changed and can go
-- backwards, and what this has to answer is only ever "which of these two came
-- later".
CREATE TABLE reading_position (
    location TEXT NOT NULL PRIMARY KEY,
    pageIndex INTEGER NOT NULL,
    pageCount INTEGER NOT NULL,
    readAt INTEGER NOT NULL DEFAULT 0
);

selectByLocation:
SELECT * FROM reading_position WHERE location = ?;

-- Every stored position at once, for the library grid.
--
-- One statement rather than one per book: the grid shows how far through each
-- book its reader is, and asking that book by book would be a query per cell on
-- a shelf that may hold hundreds. The whole table is a handful of numbers per
-- book, so reading all of it costs less than reading one cover.
selectAll:
SELECT * FROM reading_position;

-- Replace rather than update: the row holds nothing that is not being written,
-- so there is nothing to preserve. `INSERT OR REPLACE` is as old as SQLite,
-- unlike the upsert this would otherwise be - see `Document.sq`.
--
-- The subselect runs before the conflicting row is replaced, so a book being
-- written again still comes out above every other book rather than keeping the
-- place it had.
put:
INSERT OR REPLACE INTO reading_position(location, pageIndex, pageCount, readAt)
VALUES (?, ?, ?, (SELECT COALESCE(MAX(readAt), 0) + 1 FROM reading_position));

deleteByLocation:
DELETE FROM reading_position WHERE location = ?;
