import kotlin.Boolean;

-- A book in the library.
--
-- Keyed by location, which is the library's identity for a document everywhere
-- else too: importing the same file twice refreshes the entry rather than
-- adding a second one.
--
-- `sortKey` keeps the library in the order books were added. A plain rowid would
-- not: replacing a row is a delete and an insert, so a refreshed book would jump
-- to the end of a shelf it has been on for months.
--
-- `fileExists` is the last thing known about the file, from the analysis that
-- put it here - history rather than fact, corrected by the next import or
-- rescan.
--
-- The `meta*` columns are what the document says about itself, read at import.
-- All nullable: most are absent from most files, and plain text carries none.
--
-- `metaAuthors` and `metaSubjects` hold newline-separated lists rather than
-- tables of their own. Nothing queries them - they are read back whole, for one
-- book, for one screen - and a join table for a value only ever displayed is
-- schema nobody benefits from. A newline is safe because neither an author's
-- name nor a genre may contain one.
CREATE TABLE document (
    location TEXT NOT NULL PRIMARY KEY,
    fileName TEXT NOT NULL,
    extension TEXT NOT NULL,
    type TEXT NOT NULL,
    fileExists INTEGER AS Boolean NOT NULL,
    sizeBytes INTEGER NOT NULL,
    isFavorite INTEGER AS Boolean NOT NULL DEFAULT 0,
    coverImage BLOB,
    sortKey INTEGER NOT NULL,
    metaTitle TEXT,
    metaAuthors TEXT,
    metaPublisher TEXT,
    metaPublished TEXT,
    metaLanguage TEXT,
    metaDescription TEXT,
    metaSubjects TEXT,
    metaIdentifier TEXT,
    contentHash TEXT,
    onServer INTEGER AS Boolean NOT NULL DEFAULT 0
);

-- What `insertIfAbsent` reads to give a new book its place on the shelf.
--
-- `MAX(sortKey)` over an unindexed column scans the whole library, once per book
-- imported - so a folder of five thousand cost five thousand scans of a table
-- growing under it, the last book the most expensive. With this SQLite answers
-- from the end of the index without reading a row, a documented special case
-- rather than a hope.
--
-- It also happens to be `selectAll`'s order, which is not what it is for:
-- reading every column of every book is a scan whatever the planner does, and a
-- library's worth of rows sorts in no time.
CREATE INDEX document_sortKey ON document(sortKey);

-- The SHA-256 of the file, which is what names the book to a sync server and to
-- every other device - see docs/decisions/0002-content-hash-book-identity.md.
-- Null until a pass after signing in works it out: reading every byte of every
-- book costs a second per large PDF, and a reader who never syncs should never
-- pay it. Indexed for the other direction, a server's book to this shelf's.
CREATE INDEX document_contentHash ON document(contentHash);

-- The shelf, without the artwork on it.
--
-- Every column but `coverImage`, spelled out rather than `*`, because the one
-- left out is the point: a cover is around a hundred kilobytes, so two thousand
-- books is a couple of hundred megabytes sitting in memory for as long as the
-- shelf is on screen - many times what the decoded artwork is held to.
--
-- What draws a cover asks by location instead, one at a time, as the card that
-- needs it is drawn - see `selectCover`.
selectAll:
SELECT location, fileName, extension, type, fileExists, sizeBytes, isFavorite,
       sortKey, metaTitle, metaAuthors, metaPublisher, metaPublished,
       metaLanguage, metaDescription, metaSubjects, metaIdentifier, onServer
FROM document ORDER BY sortKey;

-- One book's artwork, for the card about to draw it. Bounded by what the reader
-- can see rather than by how many books they own, which is what makes reading it
-- per cover cheaper than reading it per library.
selectCover:
SELECT coverImage FROM document WHERE location = ?;

-- One book, whole. Unlike the shelf above this keeps `SELECT *`: one row's
-- artwork is a hundred kilobytes read once, and narrowing it would buy a second
-- mapper rather than any memory.
selectByLocation:
SELECT * FROM document WHERE location = ?;

-- Just the keys, for deciding what an import may leave alone. `selectAll` would
-- answer the same question, but it reads every other column of every book to
-- compare a few hundred strings.
selectLocations:
SELECT location FROM document;

-- Adding and refreshing are two statements rather than one upsert on purpose:
-- `ON CONFLICT DO UPDATE` needs SQLite 3.24 and this app's minimum Android ships
-- 3.9, so a book on a phone from 2016 would fail at the point of being stored -
-- the last place to find out about a dialect.
--
-- Ignored when the book is already there, so the shelf position it was given
-- when it was first imported is the one it keeps.
insertIfAbsent:
INSERT OR IGNORE INTO document(location, fileName, extension, type, fileExists, sizeBytes, coverImage, sortKey, metaTitle, metaAuthors, metaPublisher, metaPublished, metaLanguage, metaDescription, metaSubjects, metaIdentifier)
VALUES (?, ?, ?, ?, ?, ?, ?, (SELECT COALESCE(MAX(sortKey), 0) + 1 FROM document), ?, ?, ?, ?, ?, ?, ?, ?);

-- Everything the analyser knows, and nothing only the reader knows: a rescan
-- that re-analysed every book would otherwise un-favourite the lot, and
-- re-importing a file whose cover would not read this time would take away the
-- one already stored.
--
-- The metadata is coalesced as one block rather than field by field: what a
-- document says about itself is one reading of one file, so a re-analysis that
-- came back with nothing leaves the whole previous reading in place rather than
-- blanking six fields and keeping two.
refresh:
UPDATE document
SET fileName = :fileName,
    extension = :extension,
    type = :type,
    fileExists = :fileExists,
    sizeBytes = :sizeBytes,
    coverImage = COALESCE(:coverImage, coverImage),
    metaTitle = CASE WHEN :hasMetadata THEN :metaTitle ELSE metaTitle END,
    metaAuthors = CASE WHEN :hasMetadata THEN :metaAuthors ELSE metaAuthors END,
    metaPublisher = CASE WHEN :hasMetadata THEN :metaPublisher ELSE metaPublisher END,
    metaPublished = CASE WHEN :hasMetadata THEN :metaPublished ELSE metaPublished END,
    metaLanguage = CASE WHEN :hasMetadata THEN :metaLanguage ELSE metaLanguage END,
    metaDescription = CASE WHEN :hasMetadata THEN :metaDescription ELSE metaDescription END,
    metaSubjects = CASE WHEN :hasMetadata THEN :metaSubjects ELSE metaSubjects END,
    metaIdentifier = CASE WHEN :hasMetadata THEN :metaIdentifier ELSE metaIdentifier END,
    -- A file that changed size is different bytes, so its hash is forgotten and
    -- worked out again. One edited without changing size keeps a stale hash
    -- until it is next re-imported; rehashing every file on every rescan to
    -- catch that would cost a library's worth of reading each time.
    contentHash = CASE WHEN sizeBytes = :sizeBytes THEN contentHash ELSE NULL END
WHERE location = :location;

-- The books still to be hashed, oldest on the shelf first.
selectUnhashed:
SELECT location, fileName, extension FROM document
WHERE contentHash IS NULL AND fileExists
ORDER BY sortKey;

setContentHash:
UPDATE document SET contentHash = ? WHERE location = ?;

-- The book on this shelf with these bytes, if there is one: how a server book
-- is matched to a copy the reader already had.
selectLocationByHash:
SELECT location FROM document WHERE contentHash = ? LIMIT 1;

-- A server book not downloaded yet, placed at the location its download will
-- have. `INSERT OR IGNORE` for the import's reason: a row already there keeps
-- its place on the shelf.
insertServerBook:
INSERT OR IGNORE INTO document(location, fileName, extension, type, fileExists, sizeBytes, coverImage, sortKey, metaTitle, metaAuthors, metaPublisher, metaPublished, metaLanguage, metaDescription, metaSubjects, metaIdentifier, contentHash, onServer)
VALUES (?, ?, ?, ?, 0, ?, ?, (SELECT COALESCE(MAX(sortKey), 0) + 1 FROM document), ?, ?, ?, ?, ?, ?, ?, ?, ?, 1);

setOnServer:
UPDATE document SET onServer = ? WHERE contentHash = ?;

-- What a download needs to know about a server book: which bytes, and what to
-- call the file.
selectServerBook:
SELECT contentHash, extension FROM document WHERE location = ? AND onServer = 1 AND contentHash IS NOT NULL;

markDownloaded:
UPDATE document SET fileExists = 1 WHERE location = ?;

-- A server book never downloaded has nothing on this device but its row, so
-- when the server stops offering it - removed there, or this device signed
-- out - the row goes. One that was downloaded stays: it is a book on this
-- device now, like any other.
deleteUndownloadedByHash:
DELETE FROM document WHERE contentHash = ? AND onServer = 1 AND fileExists = 0;

deleteAllUndownloaded:
DELETE FROM document WHERE onServer = 1 AND fileExists = 0;

clearOnServer:
UPDATE document SET onServer = 0;

setFavorite:
UPDATE document SET isFavorite = ? WHERE location = ?;

deleteByLocation:
DELETE FROM document WHERE location = ?;

-- Books added after [sortKey] that are on this device, hashed, and not on the
-- sync server - the ones to add to it, oldest first.
selectLocalOnlyAfter:
SELECT location FROM document
WHERE sortKey > ? AND fileExists = 1 AND onServer = 0 AND contentHash IS NOT NULL
ORDER BY sortKey;

-- Where the library ends now, so that books added later can be told apart.
selectNewestSortKey:
SELECT COALESCE(MAX(sortKey), 0) FROM document;
