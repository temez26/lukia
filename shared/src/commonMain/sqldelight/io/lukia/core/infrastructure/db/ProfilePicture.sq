-- The picture the reader chose for themselves, if they chose one.
--
-- One row, always. There is one reader on a device - see `UserProfile` - so the
-- key is a constant rather than an identity, and choosing a new picture replaces
-- the old one instead of adding to a gallery nobody asked for.
--
-- A table rather than a preference, because a picture is not a short string: the
-- app's preference stores are held in memory and rewritten whole on every
-- change, and a photograph in one of them would be re-encoded and rewritten to
-- disk every time the reader changed their theme. It lives here for the same
-- reason cover art does, is held to the same kind of size limit - see
-- `MaxStoredAvatarBytes` - and is read once per run rather than per frame.
CREATE TABLE profile_picture (
    id INTEGER NOT NULL PRIMARY KEY,
    image BLOB NOT NULL
);

select:
SELECT image FROM profile_picture WHERE id = 0;

-- `INSERT OR REPLACE` rather than an upsert, as everywhere else in this schema:
-- the upsert syntax needs SQLite 3.24 and this app's minimum Android ships 3.9.
put:
INSERT OR REPLACE INTO profile_picture(id, image) VALUES (0, ?);

delete:
DELETE FROM profile_picture WHERE id = 0;
