<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
        The window Compose draws into. Everything visible is painted by the app
        itself; the background colour is set only so that the frames between the
        splash screen going away and the first composition arriving are the same
        colour as both of them.
    -->
    <style name="Theme.Lukia" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lukia_launch_background</item>
    </style>

    <!--
        The splash screen, reduced to the one thing it is useful for: holding the
        app's background colour on screen until there is something to draw on it.
    -->
    <style name="Theme.Lukia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lukia_launch_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/launch_icon_none</item>
        <item name="postSplashScreenTheme">@style/Theme.Lukia</item>
    </style>

</resources>
