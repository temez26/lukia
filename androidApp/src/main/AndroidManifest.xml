<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Reading a book needs nothing from the network. This is for translating a
        sentence, which is the one thing the app sends anywhere - to the service
        the reader configured, with their own key.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".LukiaApplication"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lukia">
        <!--
            uiMode is handled rather than restarted on. Changing the theme in the
            settings tells the system which appearance the app wears - see
            SystemAppearanceEffect - and that is a configuration change, so
            without this the activity is torn down and built again in the middle
            of it: the window flashes its launch colour, then the splash theme's,
            then the app's. Compose reads the new configuration either way, so
            there is nothing the restart was buying.
        -->
        <activity
            android:exported="true"
            android:name=".MainActivity"
            android:configChanges="uiMode"
            android:theme="@style/Theme.Lukia.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>