import kotlin.Boolean;

-- Somebody who can sign in.
--
-- `username` is stored as typed after validation, which allows only lower-case
-- characters, so a plain UNIQUE is already case-insensitive in practice.
--
-- `passwordHash` is an Argon2id string carrying its own salt and parameters, so
-- raising the cost later needs no column of its own.
CREATE TABLE account (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    username TEXT NOT NULL UNIQUE,
    passwordHash TEXT NOT NULL,
    isAdmin INTEGER AS Boolean NOT NULL DEFAULT 0,
    createdAt INTEGER NOT NULL
);

-- Whether the server still needs its first account, which is what `/health`
-- tells an app about to connect.
hasAny:
SELECT EXISTS(SELECT 1 FROM account);

-- The first account, made admin - and only if it is the first. One statement,
-- so two setups racing each other cannot both see an empty table.
insertFirst:
INSERT INTO account(username, passwordHash, isAdmin, createdAt)
SELECT :username, :passwordHash, 1, :createdAt
WHERE NOT EXISTS (SELECT 1 FROM account);

insert:
INSERT INTO account(username, passwordHash, isAdmin, createdAt)
VALUES (?, ?, ?, ?);

selectByUsername:
SELECT * FROM account WHERE username = ?;

selectById:
SELECT * FROM account WHERE id = ?;

countAdmins:
SELECT COUNT(*) FROM account WHERE isAdmin = 1;

setPasswordHash:
UPDATE account SET passwordHash = ? WHERE id = ?;

-- Takes the account's tokens and invites with it, through their cascades.
deleteById:
DELETE FROM account WHERE id = ?;

lastInsertId:
SELECT last_insert_rowid();

-- How many rows the last statement on this connection touched. Only meaningful
-- inside the same transaction, which is what keeps it on the same connection.
changes:
SELECT changes();

-- Every account with what it has done here, for the admin's list of people.
-- "Finished" is the app's own rule (`ReadingProgress.isFinished`): on the last
-- page. Books added count only while they are still in the library.
selectWithUsage:
SELECT
    a.username,
    a.isAdmin,
    a.createdAt,
    (SELECT COUNT(*) FROM book b WHERE b.addedBy = a.id AND b.deleted = 0) AS booksAdded,
    (SELECT COUNT(*) FROM book_state s WHERE s.accountId = a.id AND s.pageIndex IS NOT NULL) AS booksStarted,
    (
        SELECT COUNT(*) FROM book_state s
        WHERE s.accountId = a.id AND s.pageCount > 0 AND s.pageIndex + 1 >= s.pageCount
    ) AS booksFinished,
    (SELECT COUNT(*) FROM book_state s WHERE s.accountId = a.id AND s.isFavorite = 1) AS favourites,
    (SELECT COALESCE(SUM(r.durationMs), 0) FROM reading_session r WHERE r.accountId = a.id) AS readingMs,
    (SELECT COUNT(*) FROM reading_session r WHERE r.accountId = a.id) AS sessions,
    (SELECT MAX(r.startedAt + r.durationMs) FROM reading_session r WHERE r.accountId = a.id) AS lastReadAt
FROM account a
ORDER BY a.username;
