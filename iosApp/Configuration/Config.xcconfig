// Whose developer account signs the build. Empty here on purpose: it is
// personal to whoever is building, so it belongs in Local.xcconfig - which git
// ignores - rather than in a file everyone shares. Without it Xcode refuses to
// build for a device with "Signing for "iosApp" requires a development team".
// See BUILD.md.
TEAM_ID=
#include? "Local.xcconfig"

PRODUCT_NAME=Lukia
PRODUCT_BUNDLE_IDENTIFIER=io.lukia.Lukia
DEVELOPMENT_TEAM=$(TEAM_ID)

// The oldest iOS the app runs on, kept here rather than in the project file so
// Debug and Release cannot drift apart. 15.0 reaches back to the iPhone 6s and
// the first SE; the app's own floor is 14.0, where `UTType` and the content-type
// document picker arrived, and Compose Multiplatform's is lower still.
IPHONEOS_DEPLOYMENT_TARGET=15.0

CURRENT_PROJECT_VERSION=1
// Outside Gradle's reach, so this is the one copy that has to be changed by
// hand - keep it equal to `lukia.version` in gradle.properties.
MARKETING_VERSION=1.0.0

// Shared.framework is static, so the linker options its dependencies declare -
// SQLDelight's native driver needs the system SQLite - do not travel with it and
// have to be repeated by whoever links the framework in.
OTHER_LDFLAGS=$(inherited) -lsqlite3
