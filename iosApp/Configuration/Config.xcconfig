TEAM_ID=

PRODUCT_NAME=Lukia
PRODUCT_BUNDLE_IDENTIFIER=io.lukia.Lukia$(TEAM_ID)

CURRENT_PROJECT_VERSION=1
MARKETING_VERSION=1.0

// Shared.framework is static, so the linker options its dependencies declare -
// SQLDelight's native driver needs the system SQLite - do not travel with it and
// have to be repeated by whoever links the framework in.
OTHER_LDFLAGS=$(inherited) -lsqlite3